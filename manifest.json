{
  "manifest_version": 3,
  "name": "CF Themer – Codeforces Themes",
  "short_name": "CF Themer",
  "version": "1.0.0",
  "description": "Customize Codeforces with sleek dark themes, focus mode, problem timers, and custom mashup contests!",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/api/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CF Themer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": [
        "themes.js",
        "mashup-core.js",
        "content.js",
        "hud.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
